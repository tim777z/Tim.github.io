# Normalise text to LF in the repository so diffs and checksums stay stable.
* text=auto

# ---------------------------------------------------------------------------
# Vendored third-party code is a byte-exact, checksum-pinned copy of upstream.
# It must never be rewritten, otherwise the sha256 pins in vendor/manifest.json
# (enforced by `npm run verify:vendor`) would fail on a fresh clone.
# ---------------------------------------------------------------------------
vendor/** -text

# Binary media: never attempt line-ending translation or diffing.
*.amr binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.ogg binary
*.png binary
*.ods binary

# Lockfiles and CI definitions must be byte-identical everywhere.
package-lock.json -text
.github/workflows/*.yml text eol=lf
