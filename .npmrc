# Reproducible, minimal installs.
#
# This project has zero runtime and dev dependencies on purpose: every quality
# gate in CI is implemented with the Node.js standard library so that a fresh
# clone never has to execute third-party install scripts. See README.md.
engine-strict=true
save-exact=true
audit=true
fund=false
package-lock=true
# Dependency install scripts (postinstall, prepare, ...) are the most common way
# a compromised package executes code on a developer's machine or in CI. The
# one dev dependency here ships none, so refusing to run them costs nothing and
# makes the claim in README.md enforceable rather than aspirational.
ignore-scripts=true
